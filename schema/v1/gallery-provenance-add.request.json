{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gallery-provenance-add.request.json",
  "title": "POST /gallery/pieces/:id/provenance — Request (multipart/form-data)",
  "type": "object",
  "properties": {
    "provenance_type": {
      "type": "string",
      "enum": ["conversation", "source_code", "process_notes", "toolchain_detail"]
    },
    "gnirut_token": { "type": "string" },
    "content": {
      "type": "string",
      "description": "Binary file upload (provenance artifact)."
    }
  },
  "required": ["provenance_type", "gnirut_token", "content"]
}
