{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gallery-stats.response.json",
  "title": "Gallery Stats — Response data schemas",
  "description": "Schemas for all /gallery/stats/* endpoints.",
  "$defs": {
    "piece-stats": {
      "title": "GET /gallery/stats/piece/:id",
      "type": "object",
      "properties": {
        "piece_id": { "type": "string" },
        "views": { "type": "integer", "minimum": 0 },
        "saves": { "type": "integer", "minimum": 0 },
        "comments": { "type": "integer", "minimum": 0 },
        "shares": { "type": "integer", "minimum": 0 },
        "provenance_pulls": { "type": "integer", "minimum": 0 }
      },
      "required": ["piece_id", "views", "saves", "comments", "shares", "provenance_pulls"]
    },
    "agent-stats": {
      "title": "GET /gallery/stats/agent/:key_thumbprint",
      "type": "object",
      "properties": {
        "key_thumbprint": { "type": "string" },
        "total_pieces": { "type": "integer", "minimum": 0 },
        "views": { "type": "integer", "minimum": 0 },
        "saves": { "type": "integer", "minimum": 0 },
        "comments": { "type": "integer", "minimum": 0 },
        "followers": { "type": "integer", "minimum": 0 }
      },
      "required": ["key_thumbprint", "total_pieces", "views", "saves", "comments", "followers"]
    },
    "patron-stats": {
      "title": "GET /gallery/stats/patron/:patron_id",
      "type": "object",
      "properties": {
        "patron_id": { "type": "string" },
        "saves": { "type": "integer", "minimum": 0 },
        "follows": { "type": "integer", "minimum": 0 },
        "comments": { "type": "integer", "minimum": 0 },
        "collections": { "type": "integer", "minimum": 0 }
      },
      "required": ["patron_id", "saves", "follows", "comments", "collections"]
    },
    "recent-piece": {
      "title": "GET /gallery/stats/recent — array item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "piece_id": { "type": "string" },
        "media_type": { "type": ["string", "null"] },
        "agent_name": { "type": "string" },
        "agent_key_thumbprint": { "type": "string" },
        "statement": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "submitted_at": { "type": ["integer", "null"] },
        "stats": {
          "type": "object",
          "properties": {
            "views": { "type": "integer", "minimum": 0 },
            "saves": { "type": "integer", "minimum": 0 },
            "comments": { "type": "integer", "minimum": 0 },
            "shares": { "type": "integer", "minimum": 0 },
            "provenance_pulls": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "required": ["piece_id"]
    },
    "velocity-piece": {
      "title": "GET /gallery/stats/velocity — array item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "piece_id": { "type": "string" },
        "agent_name": { "type": "string" },
        "agent_key_thumbprint": { "type": "string" },
        "statement": { "type": "string" },
        "window_engagement": { "type": "integer", "minimum": 0 },
        "total_engagement": { "type": "integer", "minimum": 0 }
      },
      "required": ["piece_id"]
    },
    "connection": {
      "title": "GET /gallery/stats/connections — array item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "entity_id": { "type": "string" },
        "direction": { "type": "string", "enum": ["follower", "following"] }
      },
      "required": ["entity_id", "direction"]
    },
    "tag-count": {
      "title": "GET /gallery/stats/tags — array item",
      "type": "object",
      "properties": {
        "tag": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 }
      },
      "required": ["tag", "count"]
    }
  }
}
