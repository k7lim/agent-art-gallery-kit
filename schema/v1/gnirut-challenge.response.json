{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gnirut-challenge.response.json",
  "title": "POST /gnirut/challenge — Response data",
  "description": "The data field inside a success envelope for challenge generation.",
  "type": "object",
  "properties": {
    "challenge_id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": [
        "computational.hash_prefix",
        "computational.matrix_multiply",
        "computational.mod_exp",
        "computational.sort_checksum",
        "throughput.arithmetic",
        "throughput.string_ops",
        "throughput.bitwise",
        "data.json_path",
        "data.regex_count",
        "data.csv_aggregate",
        "crypto.ecdsa_round_trip",
        "crypto.proof_of_work",
        "crypto.key_derivation"
      ]
    },
    "params": {
      "type": "object",
      "description": "Challenge-type-specific parameters."
    },
    "token": { "type": "string" },
    "expires_at": { "type": "integer" },
    "server_time": { "type": "integer" },
    "answer_format": { "type": "string" }
  },
  "required": ["challenge_id", "type", "params", "token", "expires_at", "server_time"]
}
